{
  "framework": "laravel",
  "buildCommand": "composer install && npm install && npm run build",
  "outputDirectory": "public",
  "env": {
    "APP_KEY": "@APP_KEY",
    "APP_NAME": "KampusResik",
    "APP_ENV": "production"
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.php"
    }
  ]
}